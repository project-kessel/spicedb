# Build stage -- the Go toolchain embeds the validated FIPS module in all binaries automatically.
FROM registry.access.redhat.com/hi/go:1.26.5-fips AS base

# Builder for spicedb
FROM base AS spicedb-builder
WORKDIR /go/src/app
COPY go.mod go.sum ./
COPY . .

# VERSION is captured from SYNC.md to ensure the SpiceDB version is set to the
# correct release tag rather than a Go module pseudo-version. This is critical
# for accurate CVE scanning: scanners read debug.BuildInfo.Main.Version from the
# binary, and a pseudo-version (v0.0.0-...) causes false positives for all CVEs
# fixed after that version. The Konflux clone task must use depth: "0" and
# fetchTags: "true" so Go's VCS stamping can walk history back to the nearest tag.
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    tag=$(grep '^TAG:' SYNC.md) && VERSION=${tag#*: } && \
    go mod download && \
    go mod tidy && \
    GOFLAGS="" go build -tags="memoryprotection" -ldflags="-checklinkname=0 -X 'github.com/jzelinskie/cobrautil/v2.Version=${VERSION}'" -gcflags=all=-trimpath=/go -asmflags=all=-trimpath=/go -o spicedb ./cmd/spicedb

# Builder for health probe — pin matches upstream Dockerfile (updated during syncs).
FROM base AS health-probe-builder
WORKDIR /go/src/app
RUN git clone --branch v0.4.48 --depth 1 https://github.com/grpc-ecosystem/grpc-health-probe.git
WORKDIR /go/src/app/grpc-health-probe
RUN GOBIN=/go/bin go install -a -tags netgo -ldflags=-w

# Runtime stage -- set GODEBUG so the binary runs in FIPS mode.
FROM registry.access.redhat.com/hi/core-runtime:2.43-openssl-fips

WORKDIR /

COPY --from=health-probe-builder /go/bin/grpc-health-probe /bin/grpc_health_probe
COPY --from=spicedb-builder /go/src/app/spicedb /usr/local/bin/spicedb
ENV GODEBUG=fips140=on
ENV PATH="$PATH:/usr/local/bin"
EXPOSE 50051
ENTRYPOINT ["spicedb"]
